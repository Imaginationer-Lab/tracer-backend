# 복사해서 .env로 쓴다 (.env는 git에 올라가지 않음). 설명은 docs/deploy.md

# 공개 저장소만 읽으므로 권한 없는 토큰으로 충분하다. 없으면 IP당 시간당 60회
GITHUB_TOKEN=

# compose의 db(Postgres) 비밀번호. 서버에 올릴 때는 긴 무작위 값으로 바꾼다
POSTGRES_PASSWORD=

# 비워 두면 compose의 db를 쓴다. Supabase 등 다른 Postgres로 붙을 때만 채운다
# DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>

# ANALYZER_THREADS=2
# RATE_LIMIT_BURST=3
# RATE_LIMIT_REFILL_SECONDS=60
# TRUST_PROXY=false
