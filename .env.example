# 복사해서 .env로 쓴다 (.env는 git에 올라가지 않음). 설명은 docs/deploy.md

# 공개 저장소만 읽으므로 권한 없는 토큰으로 충분하다. 없으면 IP당 시간당 60회
GITHUB_TOKEN=

# 비워 두면 compose의 로컬 MySQL을 쓴다. kangdora로 붙을 때만 채운다
# DATABASE_URL=mysql://outage:<비밀번호>@host.docker.internal:13306/outage_map

# 로컬 MySQL 비밀번호를 바꾸고 싶을 때
# MYSQL_PASSWORD=
# MYSQL_ROOT_PASSWORD=

# ANALYZER_THREADS=2
# RATE_LIMIT_BURST=3
# RATE_LIMIT_REFILL_SECONDS=60
# TRUST_PROXY=false
